# --- Neon Postgres ---
# From your Neon project dashboard: Connection Details > Connection string (pooled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# --- Auth ---
# Any long random string. Generate one with: openssl rand -base64 48
JWT_SECRET=

# --- Stripe ---
# From the Stripe Dashboard > Developers > API keys (use test keys while developing)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` (local dev) or Dashboard > Developers > Webhooks (production)
STRIPE_WEBHOOK_SECRET=
# Stripe needs a currency it supports for your account's country. USD is the safe default.
STRIPE_CURRENCY=usd

# --- App ---
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# --- Email (optional). Without RESEND_API_KEY, emails are skipped and logged to the console.
# Sign up at resend.com. For real delivery, verify your own domain and use it in EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=DonateUZ <onboarding@resend.dev>
